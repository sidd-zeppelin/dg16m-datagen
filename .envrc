use flake
layout uv

# Pass through display-related vars so matplotlib/GUI works inside the nix shell
# Don't override DISPLAY if not set — wrong default causes X11 auth failures on Wayland
[ -n "$DISPLAY" ] && export DISPLAY
[ -n "$WAYLAND_DISPLAY" ] && export WAYLAND_DISPLAY
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
[ -n "$XAUTHORITY" ] && export XAUTHORITY
